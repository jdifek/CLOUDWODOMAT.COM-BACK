generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  name         String?
  surname      String?
  phone        String?
  company      String?
  appid        String?
  saler        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  devices      Device[]
  subscription Subscription?
  payments     Payment[]
  CardNote     CardNote[]
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  price                Float
  devicesCount         Int
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  stripePaymentId String   @unique
  amount          Float
  status          String
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CardNote {
  id         String   @id @default(cuid())
  userId     String
  cardNumber String
  phone      String?
  name       String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardNumber])
}

// Добавить в schema.prisma (после этого: npx prisma migrate dev -n add_stats)

// Сырые транзакции (потребление). Источник правды для дедупликации и пересчёта.
model Transaction {
  id         String   @id @default(cuid())
  saler      String
  payId      String                  // pay_id / key_id / alipay_number / id из китайского API
  deviceId   String
  location   String?
  paidAt     DateTime                // UTC
  day        String                  // 'YYYY-MM-DD' в STATS_TZ — день для агрегации
  liters     Float
  amount     Float
  noDispense Boolean  @default(false) // оплата есть, воды 0
  payType    String   @default("qr")  // card | cash | qr | terminal
  raw        Json?                    // исходная запись API
  createdAt  DateTime @default(now())

  @@unique([saler, payId])
  @@index([saler, day, deviceId])
  @@index([saler, paidAt])
}

// Агрегат "автомат × день". Общая статистика = SUM по дням/автоматам.
model DailyStat {
  saler           String
  deviceId        String
  day             String
  location        String?
  liters          Float
  amount          Float
  txCount         Int
  noDispenseCount Int
  cardCount       Int      @default(0)
  cashCount       Int      @default(0)
  qrCount         Int      @default(0)
  terminalCount   Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@id([saler, deviceId, day])
  @@index([saler, day])
}

// Курсоры синхронизации по каждому saler
model SyncState {
  saler          String    @id
  appid          String
  syncedTo       DateTime? // верхняя граница: всё до этого момента уже загружено
  backfilledFrom DateTime? // нижняя граница: история загружена начиная с этого момента
  lastRunAt      DateTime?
  lastError      String?
}
